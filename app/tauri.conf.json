{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magpie",
  "version": "0.1.0",
  "identifier": "app.magpie.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Magpie 喜鹊",
        "width": 960,
        "height": 680,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "vii",
    "shortDescription": "Magpie 喜鹊 — desktop messenger between AI agents and you",
    "longDescription": "Collects results from AI agents, scheduled tasks and scripts, and makes sure a human sees them: desktop toasts, a desktop pet, full-screen alerts and phone notifications, with replies relayed back.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
